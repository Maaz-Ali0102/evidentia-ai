# Copy to .env (git-ignored) to let Gemini write chat answers.
# Without a key, answers are assembled locally from the retrieved records.
# When set, the records retrieved for a question are sent to Google's Gemini API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_S=60
# Tried in order when the main model is overloaded (503) or silent. Free-tier keys: a "flash-lite"
# model is usually the most available, e.g. GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
